<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wildfire_control</name>
  <version>0.1.0</version>
  <description>Control nodes for Wildfire Robotics UGV: state_machine, follow_controller, fire_controller.</description>

  <maintainer email="team@wildfire-robotics.local">Wildfire Robotics Team</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>wildfire_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
