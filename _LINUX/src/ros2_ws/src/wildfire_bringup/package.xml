<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wildfire_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configuration for Wildfire Robotics UGV.</description>

  <maintainer email="team@wildfire-robotics.local">Wildfire Robotics Team</maintainer>
  <license>MIT</license>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>wildfire_vision</exec_depend>
  <exec_depend>wildfire_control</exec_depend>
  <exec_depend>wildfire_msgs</exec_depend>
  <!-- micro_ros_agent is built from source by _LINUX/setup.sh into
       /home/project/microros_ws. It is exec-only (no rosdep key on
       Humble apt), so we do not declare it via <exec_depend>. The
       launch file gates it with UnlessCondition(use_sim) to keep
       the simulated stack free of the dependency. -->


  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
